# jest-puppeteer 4 declares a peer of puppeteer ">= 1.5.0 < 3" while the e2e suite runs
# puppeteer 13. That pairing is what CI has run for years - npm 6 only warned about it -
# but npm 7+ turns the mismatch into a hard ERESOLVE and no install completes. Moving
# jest-puppeteer to a range that accepts puppeteer 13 means 6.x, which ships a jest 27
# environment against @woocommerce/e2e-environment's jest 25. Keep the known-good versions
# and the peer handling they were resolved under.
legacy-peer-deps=true
