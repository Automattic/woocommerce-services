{
	"name": "woocommerce-services",
	"version": "3.7.7",
	"scripts": {
		"start": "cross-env NODE_ENV=development CALYPSO_CLIENT=true webpack serve --port 8085 --host 127.0.0.1",
		"watch": "cross-env NODE_ENV=development CALYPSO_CLIENT=true webpack --watch",
		"prepare": "husky install",
		"dist": "cross-env NODE_ENV=production DISABLE_FEATURES=wpcom-user-bootstrap CALYPSO_CLIENT=true webpack",
		"analyze": "cross-env ANALYZE=true NODE_ENV=production DISABLE_FEATURES=wpcom-user-bootstrap CALYPSO_CLIENT=true webpack",
		"eslint": "eslint tasks/ client/",
		"eslint:fix": "eslint --fix tasks/ client/",
		"test": "npm run test-client",
		"test-client": "TZ='UTC' jest -c=tests/client/jest.config.js",
		"test-client:watch": "npm run -s test-client -- --watch",
		"prerelease": "npm run i18n && node tasks/i18n-download && npm run i18njson",
		"release": "node tasks/release.js",
		"i18n": "cross-env NODE_ENV=i18n DISABLE_FEATURES=wpcom-user-bootstrap CALYPSO_CLIENT=true webpack && node tasks/i18n",
		"i18njson": "node tasks/i18njson",
		"update-deps": "rm -f npm-shrinkwrap.json && rm -rf node_modules && npm install && npm shrinkwrap",
		"build": "echo yes | npm run release && cp release/woocommerce-services.zip ./",
		"up": "docker-compose up --build --force-recreate -d && ./bin/docker-setup.sh",
		"down": "docker-compose down",
		"test:e2e-docker-up": "env WP_VERSION=6.7.2 TRAVIS_MARIADB_VERSION=10.8.3 npx wc-e2e docker:up",
		"test:e2e-docker-down": "npx wc-e2e docker:down",
		"test:e2e-docker-ping": "bash ./tests/bin/wait-for-e2e-build.sh",
		"test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules npx wc-e2e test:e2e",
		"test:e2e:record": "cross-env NODE_OPTIONS=--experimental-vm-modules WC_E2E_SCREENSHOTS=1 npx wc-e2e test:e2e",
		"test:e2e-dev": "cross-env NODE_OPTIONS=--experimental-vm-modules npx wc-e2e test:e2e-dev",
		"env:start": "npx --yes @wordpress/env@^10.14.0 start",
		"env:stop": "npx --yes @wordpress/env@^10.14.0 stop",
		"env:destroy": "npx --yes @wordpress/env@^10.14.0 destroy",
		"env:cli": "npx --yes @wordpress/env@^10.14.0 run cli",
		"test:e2e-playwright:install": "cd tests/e2e-playwright && npm ci && npx playwright install chromium",
		"test:e2e-playwright": "cd tests/e2e-playwright && npx playwright test",
		"test:e2e-playwright:local": "BASE_URL=${BASE_URL:-$(node tests/e2e-playwright/bin/resolve-base-url.js)} npm run test:e2e-playwright",
		"test:e2e-playwright:local:show": "BASE_URL=${BASE_URL:-$(node tests/e2e-playwright/bin/resolve-base-url.js)} npm run test:e2e-playwright -- --headed",
		"tube:setup": "./bin/jurassic-tube-setup.sh",
		"tube:start": "./docker/bin/jt/tunnel.sh",
		"tube:stop": "./docker/bin/jt/tunnel.sh break",
		"test:e2e-tooling": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config tests/e2e/tooling/jest.config.js --runInBand"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/Automattic/woocommerce-services"
	},
	"license": "GPL-2.0",
	"engines": {
		"node": ">=24"
	},
	"description": "Connect allthethings",
	"devDependencies": {
		"@slack/web-api": "^5.15.0",
